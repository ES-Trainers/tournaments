// ES TRAINERS — Firestore Security Rules (Phase 2.2)
// Apply to BOTH Firebase projects (BGMI and FF MAX) — identical file:
//   firebase use bgmi  && firebase deploy --only firestore:rules
//   firebase use ffmax && firebase deploy --only firestore:rules
//
// Cloud Functions use the Admin SDK, which BYPASSES these rules by
// design (it is the trusted backend). These rules exist so that
// nothing ELSE — no browser, no script — can read or write the
// registration data.
//
// The public homepage and the registration page read tournaments with
// getDoc / onSnapshot; "allow read" covers get and list, so live
// updates keep working.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Future admin panel: Firebase Authentication + a custom claim
    // `admin: true`, set ONLY server-side (Admin SDK). Nobody can
    // grant themselves a custom claim from the browser. Until admin
    // users exist this evaluates to false for everyone.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public read (homepage + registration page); writes admin-only.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Created ONLY by the submitRegistration Cloud Function.
    // Public: no read, no write. Admin: read-only (writes to these
    // stay with trusted server code).
    match /registrations/{registrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Player 1 email/phone. Same treatment.
    match /privateRegistrations/{registrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Team-name reservations (flat: {tournamentId}_{sha256(name)}).
    match /teamNames/{reservationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
