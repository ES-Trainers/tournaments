{
  "name": "es-trainers-functions",
  "description": "ES Trainers \u2014 trusted backend for registration writes (Phase 2.2). Deployed identically to both the BGMI and FF MAX Firebase projects; see README.md.",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test tests/submit.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-es-trainers \"node --test tests/rules.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.13.0",
    "firebase-tools": "^13.0.0"
  }
}
